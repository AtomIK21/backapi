# ────────────────────────────────────────────────────────
# 1) CORS headers para TODAS las respuestas
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin   "http://localhost:3000"
    Header always set Access-Control-Allow-Credentials "true"
    Header always set Access-Control-Allow-Methods  "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers  "Content-Type, Authorization, X-Requested-With"
</IfModule>

# ────────────────────────────────────────────────────────
# 2) Si es preflight OPTIONS, DETÉN el rewriting aquí (no redirijas)
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [L]

# ────────────────────────────────────────────────────────
# 3) Evita listar directorios y multi-views
Options -Indexes -MultiViews
DirectorySlash Off
AcceptPathInfo On

# ────────────────────────────────────────────────────────
# 4) Para todo lo demás (archivos inexistentes), pasa a index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [QSA,L]
